{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
{
			"name": "Debug: Hello Psy-Q!",
			"type": "gdb",
			"request": "attach",
			"target": "localhost:3333",
			"remote": true,
			"cwd": "${workspaceRoot}/build",
			"valuesFormatting": "parseText",
			"registerLimit": "1-32",
			"frameFilters": false,
			"showDevDebugOutput": false,
			"printCalls": false,
			"stopAtConnect": true,
			"gdbpath": "gdb-multiarch",
			"windows": {
				"gdbpath": "gdb-multiarch.exe"
			},
			"osx": {
				"gdbpath": "gdb"
			},
			"executable": "${workspaceRoot}/build/hello_psyq.elf",
			"setupCommands": [
				{ "text": "set mi-async off" },
				{ "text": "set remotetimeout 0" },
				{ "text": "set logging file build/gen/hello_gte.gdb.log" },
				{ "text": "set logging redirect on" }
			],
			"autorun": [
				"monitor reset shellhalt",
				"load hello_psyq.elf",
				"source scripts/gdb/gdb_tape_atoms.gdb",
				"tbreak main",
				"continue"
			]
		},
		{
			"name": "Debug: Hello GPU Psy-Q!",
			"type": "gdb",
			"request": "attach",
			"target": "localhost:3333",
			"remote": true,
